# Environment variables for EDI.
# Copy this file to `.env` and fill in the values.
#
# All three are read by the Python backend. The frontend holds no credentials
# of its own -- it talks only to the backend, which is the only thing that
# reaches Supabase or the LLM.

# Google AI Studio key for Gemini. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The Supabase *service role* key, from Project Settings -> API.
# This bypasses row-level security, so it must stay server-side. Never put it
# in a NEXT_PUBLIC_ variable: those are inlined into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Override the Gemini model (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
